local function NormalizeEggName(name)
    return string.lower(tostring(name or "")):gsub("%s+", " ")
end

local function ReadNumberWithSuffix(value)
    local s = tostring(value or ""):upper():gsub(",", "")
    local n = tonumber(string.match(s, "%d+%.?%d*"))
    if not n then
        return nil
    end

    if string.find(s, "T", 1, true) then
        return n * 1e12
    elseif string.find(s, "B", 1, true) then
        return n * 1e9
    elseif string.find(s, "M", 1, true) then
        return n * 1e6
    elseif string.find(s, "K", 1, true) then
        return n * 1e3
    end

    return n
end

local function GetLiveEggLuck(obj)
    if not obj then
        return nil
    end

    -- Attributes are the safest live fallback.
    for attributeName, value in pairs(obj:GetAttributes()) do
        local key = NormalizeEggName(attributeName)
        if string.find(key, "luck", 1, true)
            or string.find(key, "value", 1, true)
            or string.find(key, "rarity", 1, true) then

            local number = ReadNumberWithSuffix(value)
            if number then
                return number
            end
        end
    end

    -- Also inspect simple StringValue/NumberValue descendants.
    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("StringValue") or child:IsA("NumberValue") then
            local key = NormalizeEggName(child.Name)

            if string.find(key, "luck", 1, true)
                or string.find(key, "value", 1, true) then

                local number = ReadNumberWithSuffix(child.Value)
                if number then
                    return number
                end
            end
        end
    end

    return nil
end

local function GetEggRankByName(name)
    if EggNameRank[name] then
        return EggNameRank[name]
    end

    local lowerName = NormalizeEggName(name)

    for eggName, rank in pairs(EggNameRank) do
        if string.find(
            lowerName,
            NormalizeEggName(eggName),
            1,
            true
        ) then
            return rank
        end
    end

    return nil
end

local function GetEggRank(obj)
    if not obj then
        return nil
    end

    -- First choice: exact/current egg name.
    local rank = GetEggRankByName(obj.Name)
    if rank then
        return rank
    end

    -- Unknown 90K / 500K eggs can still be ranked if the live object
    -- exposes its value.
    local luck = GetLiveEggLuck(obj)
    if luck then
        return KnownLuckRank[luck]
    end

    return nil
end

