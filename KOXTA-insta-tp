--==============================================================
-- PERSONAJE
--==============================================================

local function getCharacter()

    local character = player.Character

    if not character then
        return nil,nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root then
        return character,nil
    end

    return character,root
end

--==============================================================
-- CONGELAR PERSONAJE
--==============================================================

local savedFreeze = {}

local function freezeCharacter()

    local character,root = getCharacter()

    if not character or not root then
        return false
    end

    savedFreeze = {}

    for _,obj in ipairs(character:GetDescendants()) do

        if obj:IsA("BasePart") then

            savedFreeze[obj] = {
                Anchored = obj.Anchored,
                CanCollide = obj.CanCollide
            }

            obj.Anchored = true
        end
    end

    return true
end

local function unfreezeCharacter()

    for obj,data in pairs(savedFreeze) do

        if obj and obj.Parent then
            obj.Anchored = data.Anchored
            obj.CanCollide = data.CanCollide
        end
    end

    savedFreeze = {}
end

--==============================================================
-- PLOTS
--==============================================================

local function obtenerPlots()

    return workspace:FindFirstChild("Plots")
        or workspace:FindFirstChild("plots")
        or workspace:FindFirstChild("Bases")
        or workspace:FindFirstChild("bases")
end

local function esMiValor(valor)

    if valor == player then
        return true
    end

    if valor == player.Name then
        return true
    end

    if valor == player.DisplayName then
        return true
    end

    if tostring(valor) == tostring(player.UserId) then
        return true
    end

    return false
end

--==============================================================
-- BUSCAR MI PLOT
--==============================================================

local function buscarMiPlot()

    local plots = obtenerPlots()

    if not plots then
        return nil
    end

    for _,plot in ipairs(plots:GetChildren()) do

        -- Attributes
        for nombre,valor in pairs(plot:GetAttributes()) do

            local n = string.lower(tostring(nombre))

            if n:find("owner")
            or n:find("player")
            or n:find("user") then

                if esMiValor(valor) then
                    return plot
                end
            end
        end

        -- Values
        for _,obj in ipairs(plot:GetDescendants()) do

            if obj:IsA("StringValue")
            or obj:IsA("ObjectValue")
            or obj:IsA("IntValue")
            or obj:IsA("NumberValue") then

                local nombre = string.lower(obj.Name)

                if nombre:find("owner")
                or nombre:find("player")
                or nombre:find("user") then

                    local ok,valor = pcall(function()
                        return obj.Value
                    end)

                    if ok and esMiValor(valor) then
                        return plot
                    end
                end
            end
        end
    end

    return nil
end

--==============================================================
-- SPAWN DEL PLOT
--==============================================================

local function encontrarSpawn(plot)

    if not plot then
        return nil
    end

    -- SpawnLocation real
    for _,obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("SpawnLocation") then
            return obj
        end
    end

    -- Spawn por nombre
    local nombres = {
        spawn = true,
        plotspawn = true,
        spawnlocation = true,
        respawn = true,
        respawnpoint = true,
        homespawn = true
    }

    for _,obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("BasePart") then

            local nombre = string.lower(obj.Name)

            if nombres[nombre] then
                return obj
            end
        end
    end

    return nil
end

--==============================================================
-- ULTRA TP A MI PLOT
--==============================================================

local function UltraTP()

    local character,root = getCharacter()

    if not character or not root then
        return false
    end

    local plot = buscarMiPlot()

    if not plot then
        warn("ULTRA TP: no se encontró tu Plot")
        return false
    end

    local spawn = encontrarSpawn(plot)

    if not spawn then
        warn("ULTRA TP: no se encontró el Spawn")
        return false
    end

    root.CFrame = spawn.CFrame + Vector3.new(0,HEIGHT_OFFSET,0)

    return true
end

--==============================================================
-- DETECTAR POSIBLES HUEVOS
--==============================================================

local function pareceHuevo(obj)

    local nombre = string.lower(obj.Name)

    if nombre:find("egg")
    or nombre:find("huevo")
    or nombre:find("egg") then

        return true
    end

    return false
end

--==============================================================
-- OBTENER VALOR DEL HUEVO
--==============================================================

local function obtenerValor(obj)

    local mejorValor = -math.huge

    -- Attributes
    for nombre,valor in pairs(obj:GetAttributes()) do

        local n = string.lower(tostring(nombre))

        if n:find("value")
        or n:find("price")
        or n:find("rarity")
        or n:find("luck")
        or n:find("chance")
        or n:find("worth") then

            local numero = tonumber(valor)

            if numero then
                mejorValor = math.max(mejorValor,numero)
            end
        end
    end

    -- Values dentro del huevo
    for _,v in ipairs(obj:GetDescendants()) do

        if v:IsA("IntValue")
        or v:IsA("NumberValue") then

            local nombre = string.lower(v.Name)

            if nombre:find("value")
            or nombre:find("price")
            or nombre:find("luck")
            or nombre:find("chance")
            or nombre:find("worth") then

                mejorValor = math.max(
                    mejorValor,
                    tonumber(v.Value) or -math.huge
                )
            end
        end
    end

    return mejorValor
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function buscarMejorHuevo()

    local character,root = getCharacter()

    if not root then
        return nil
    end

    local mejor = nil
    local mejorValor = -math.huge
    local mejorDistancia = math.huge

    for _,obj in ipairs(workspace:GetDescendants()) do

        if obj:IsA("Model") or obj:IsA("BasePart") then

            if pareceHuevo(obj) then

                local part = nil

                if obj:IsA("BasePart") then
                    part = obj
                else
                    part =
                        obj.PrimaryPart
                        or obj:FindFirstChildWhichIsA("BasePart",true)
                end

                if part then

                    local distancia =
                        (root.Position - part.Position).Magnitude

                    if distancia <= SEARCH_RADIUS then

                        local valor = obtenerValor(obj)

                        if valor > mejorValor then

                            mejor = obj
                            mejorValor = valor
                            mejorDistancia = distancia

                        elseif valor == mejorValor
                        and distancia < mejorDistancia then

                            mejor = obj
                            mejorDistancia = distancia
                        end
                    end
                end
            end
        end
    end

    return mejor
end

--==============================================================
-- PARTE PRINCIPAL DEL HUEVO
--==============================================================

local function obtenerParte(obj)

    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then

        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart",true)
    end

    return nil
end

--==============================================================
-- BUSCAR PROMPT DEL HUEVO
--==============================================================

local function encontrarPrompt(obj)

    if not obj then
        return nil
    end

    for _,v in ipairs(obj:GetDescendants()) do

        if v:IsA("ProximityPrompt") then
            return v
        end
    end

    return nil
end

--==============================================================
-- GRAB
--==============================================================

local function agarrarHuevo(huevo)

    local prompt = encontrarPrompt(huevo)

    if not prompt then
        warn("No encontré ProximityPrompt en:",huevo:GetFullName())
        return false
    end

    print("PROMPT:",prompt:GetFullName())

    pcall(function()
        prompt.HoldDuration = 0
    end)

    pcall(function()
        fireproximityprompt(prompt)
    end)

    return true
end

--==============================================================
-- CICLO AUTO STEAL
--==============================================================

local function ejecutarSteal()

    if BUSY then
        return
    end

    BUSY = true

    status.Text = "STATUS: BUSCANDO MEJOR HUEVO"

    local huevo = buscarMejorHuevo()

    if not huevo then

        status.Text = "STATUS: NO HAY HUEVO"

        BUSY = false

        return
    end

    local part = obtenerParte(huevo)

    if not part then

        BUSY = false
        return
    end

    ----------------------------------------------------------
    -- TP AL HUEVO
    ----------------------------------------------------------

    status.Text = "STATUS: TP AL MEJOR HUEVO"

    local character,root = getCharacter()

    if not root then
        BUSY = false
        return
    end

    root.CFrame =
        CFrame.new(part.Position + Vector3.new(0,HEIGHT_OFFSET,0))

    task.wait(0.15)

    ----------------------------------------------------------
    -- CONGELAR
    ----------------------------------------------------------

    status.Text = "STATUS: CONGELADO • AGARRANDO"

    freezeCharacter()

    task.wait(0.1)

    ----------------------------------------------------------
    -- AGARRAR
    ----------------------------------------------------------

    agarrarHuevo(huevo)

    task.wait(0.35)

    ----------------------------------------------------------
    -- DESCONGELAR
    ----------------------------------------------------------

    unfreezeCharacter()

    ----------------------------------------------------------
    -- VOLVER AL PLOT
    ----------------------------------------------------------

    status.Text = "STATUS: VOLVIENDO A MI PLOT"

    task.wait(0.1)

    UltraTP()

    task.wait(0.5)

    BUSY = false
end

--==============================================================
-- AUTO STEAL LOOP
--==============================================================

task.spawn(function()

    while gui.Parent do

        if AUTO_STEAL and not BUSY then
            ejecutarSteal()
        end

        task.wait(0.5)
    end

end)

