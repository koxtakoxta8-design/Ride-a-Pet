local function ButtonPulse(button)

    local original = button.Size

    TweenService:Create(
        button,
        TweenInfo.new(
            0.08,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size = UDim2.fromOffset(
                original.X.Offset - 5,
                original.Y.Offset - 3
