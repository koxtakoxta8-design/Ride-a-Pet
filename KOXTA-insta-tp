        }
    ):Play()

    task.delay(0.08, function()

        if button.Parent then

            TweenService:Create(
                button,
                TweenInfo.new(
                    0.14,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),
                {
                    Size = original
                }
            ):Play()

        end

    end)

end

