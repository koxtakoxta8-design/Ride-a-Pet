--==============================================================
-- CHARACTER
--==============================================================

local function Root()

    local Character = Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

--==============================================================
-- POSICIÓN
--==============================================================

local function PositionOf(Object)

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then

        if Object.PrimaryPart then
            return Object.PrimaryPart.Position
        end

        local Part =
            Object:FindFirstChildWhichIsA("BasePart",true)

        if Part then
            return Part.Position
        end
    end

    return nil
end

--==============================================================
-- ES HUEVO
--==============================================================

local function IsEgg(Object)

    local Name = Object.Name:lower()

    return
        Name:find("egg") ~= nil
        or Name:find("huevo") ~= nil
        or Object:GetAttribute("IsEgg") == true
end

--==============================================================
-- LUCK
--==============================================================

local function GetLuck(Object)

    for _,Name in ipairs({
        "Luck",
        "luck",
        "EggLuck",
        "RarityValue"
    }) do

        local Value = Object:GetAttribute(Name)

        if typeof(Value) == "number" then
            return Value
        end
    end

    for _,Child in ipairs(Object:GetDescendants()) do

        if Child:IsA("NumberValue")
        or Child:IsA("IntValue") then

            local N = Child.Name:lower()

            if N == "luck"
            or N == "eggluck"
            or N == "rarityvalue" then

                return Child.Value
            end
        end
    end

    return KnownLuck[Object.Name] or 0
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function BestEgg()

    local Result = nil
    local Highest = -math.huge

    for _,Object in ipairs(workspace:GetDescendants()) do

        if IsEgg(Object) then

            local Position = PositionOf(Object)

            if Position then

                local Value = GetLuck(Object)

                if Value > Highest then

                    Highest = Value

                    Result = {
                        Object = Object,
                        Position = Position,
                        Luck = Value
                    }
                end
            end
        end
    end

    return Result
end

--==============================================================
-- TP
--==============================================================

local function TP(Position)

    local Character = Player.Character
    local RootPart = Root()

    if not Character or not RootPart then
        return false
    end

    RootPart.CFrame =
        CFrame.new(Position + Vector3.new(0,3,0))

    return true
end

--==============================================================
-- BUSCAR PROMPT
--==============================================================

local function FindPrompt(Egg)

    if not Egg then
        return nil
    end

    if Egg:IsA("ProximityPrompt") then
        return Egg
    end

    local Prompt =
        Egg:FindFirstChildWhichIsA(
            "ProximityPrompt",
            true
        )

    if Prompt then
        return Prompt
    end

    return nil
end

--==============================================================
-- RECOGER
--==============================================================

local function CollectEgg(Egg)

    Status.Text = "Estado: RECOGIENDO"

    local Prompt = FindPrompt(Egg.Object)

    if not Prompt then
        return false
    end

    -- En una experiencia propia, este prompt debe ser
    -- el mecanismo autorizado por tu sistema de huevos.

    if Prompt.Enabled then

        pcall(function()
            Prompt:InputHoldBegin()
        end)

        task.wait(math.max(Prompt.HoldDuration,0.05))

        pcall(function()
            Prompt:InputHoldEnd()
        end)

        return true
    end

    return false
end

--==============================================================
-- OWNER
--==============================================================

local function IsMine(Object)

    for _,Name in ipairs({
        "Owner",
        "owner",
        "OwnerName",
        "ownerName"
    }) do

        local Attribute = Object:GetAttribute(Name)

        if Attribute ~= nil then

            if tostring(Attribute) == Player.Name
            or tostring(Attribute) == tostring(Player.UserId) then

                return true
            end
        end

        local Value =
            Object:FindFirstChild(Name,true)

        if Value then

            if Value:IsA("StringValue")
            and Value.Value == Player.Name then
                return true
            end

            if Value:IsA("ObjectValue")
            and Value.Value == Player then
                return true
            end

            if Value:IsA("IntValue")
            and Value.Value == Player.UserId then
                return true
            end
        end
    end

    return false
end

--==============================================================
-- BUSCAR MI PLOT
--==============================================================

local function FindMyPlot()

    for _,Object in ipairs(workspace:GetDescendants()) do

        local Name = Object.Name:lower()

        if Name:find("plot")
        or Name:find("tycoon")
        or Name:find("base") then

            if IsMine(Object) then

                local Position =
                    PositionOf(Object)

                if Position then
                    return Object,Position
                end
            end
        end
    end

    return nil
end

--==============================================================
-- SECUENCIA COMPLETA
--==============================================================

local function Run()

    if BUSY or not AUTO then
        return
    end

    BUSY = true

    local Egg = BestEgg()

    if not Egg then

        Status.Text = "Estado: NO HAY HUEVOS"
        BUSY = false
        return
    end

    Best.Text =
        "🏆 Mejor: " .. Egg.Object.Name

    Luck.Text =
        "Luck: " .. tostring(Egg.Luck)

    -- 1. IR AL HUEVO
    Status.Text = "Estado: TP AL HUEVO"

    TP(Egg.Position)

    task.wait(.15)

    -- 2. RECOGER
    CollectEgg(Egg)

    task.wait(.25)

    -- 3. BUSCAR PLOT
    Status.Text = "Estado: BUSCANDO MI PLOT"

    local MyPlot,PlotPosition =
        FindMyPlot()

    if not MyPlot then

        Plot.Text = "Plot: NO ENCONTRADO"
        Status.Text = "Estado: ERROR PLOT"

        BUSY = false
        return
    end

    Plot.Text = "Plot: ENCONTRADO"

    -- 4. VOLVER AL PLOT
    Status.Text = "Estado: TP AL PLOT"

    TP(PlotPosition)

    task.wait(.3)

    Status.Text = "Estado: COMPLETADO"

    BUSY = false
end

