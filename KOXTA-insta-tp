    if BUSY then return false end
    BUSY = true

    StatusLabel.Text = "Estado: BUSCANDO"

    local Egg = FindBestEggFast()

    if not Egg then
        BestLabel.Text = "🏆 Mejor: NINGUNO"
        StatusLabel.Text = "Estado: SIN HUEVO"
        BUSY = false
        return false
    end

    BestLabel.Text = "🏆 Mejor: " .. Egg.Object.Name

    local Position = GetPosition(Egg.Object)
    if not Position then
        StatusLabel.Text = "Estado: ACTUALIZANDO HUEVO"
        BUSY = false
        return false
    end

    Egg.Position = Position

    if IsExcluded(Position) then
        StatusLabel.Text = "Estado: HUEVO EXCLUIDO"
        BUSY = false
        return false
    end

    StatusLabel.Text = "Estado: TP AL HUEVO"

    if not Teleport(Position) then
        StatusLabel.Text = "Estado: TP FALLÓ"
        BUSY = false
        return false
    end

    task.wait(0.025)

    local Collected = BurstCollect(Egg)

    if not Egg.Object.Parent then
        if EggByType[Egg.EggType]
        and EggByType[Egg.EggType].Object == Egg.Object then
            EggByType[Egg.EggType] = nil
        end
        EggCache[Egg.Object] = nil
    end

    task.wait(0.015)

    local Plot = FindMyPlot()
    if Plot then
        StatusLabel.Text = "Estado: TP AL PLOT"
        Teleport(Plot)
        task.wait(0.03)
        StatusLabel.Text = Collected
            and "Estado: COMPLETADO"
            or "Estado: AUTO GRAB NO CONFIRMADO"
    else
        StatusLabel.Text = Collected
            and "Estado: HUEVO RECOGIDO"
            or "Estado: AUTO GRAB NO CONFIRMADO"
    end

    BUSY = false
    return Collected
end

