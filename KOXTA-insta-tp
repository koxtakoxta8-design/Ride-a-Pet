        local luckText = "N/A"

        if data and data.Luck then
            luckText = tostring(data.Luck)
        else
            local liveLuck = GetLiveEggLuck(BestEgg)

            if liveLuck then
                luckText = tostring(liveLuck)
            end
        end

        EggText.Text =
            "🥚  MEJOR HUEVO\n"
            .. tostring(BestEgg.Name)
            .. "   •   🍀 Lucky: "
            .. luckText

        -- Mantener el objetivo visible con el mismo huevo real.
        if TargetLabel then
            TargetLabel.Text =
                "🎯 OBJETIVO: " .. tostring(BestEgg.Name)
        end

    else

        EggText.Text =
            "🥚  MEJOR HUEVO\nBuscando..."

        if TargetLabel then
            TargetLabel.Text = "🎯 OBJETIVO: Buscando..."
        end

    end

end

--==============================================================
-- CICLO
--==============================================================

local function DoCycle()

    if not InstaTP then
        return
    end

    -- =========================================================
    -- 1. BUSCAR
    -- =========================================================
    CycleState = "SEARCHING"
    Status.Text = "● BUSCANDO HUEVOS"

    RefreshBestEgg()
    UpdateUI()

    local egg = BestEgg

    if not egg or not egg.Parent then
        CycleState = "IDLE"
        Status.Text = "● BUSCANDO HUEVOS"
        return
    end

    -- Congelar ESTE objetivo. No se cambia hasta terminar todo
    -- el ciclo completo.
    CycleBusy = true
    CycleState = "GOING_TO_EGG"

    Status.Text = "● YENDO AL MEJOR HUEVO"
    UpdateUI()

    -- =========================================================
    -- 2. TP AL HUEVO ELEGIDO
    -- =========================================================
    if not TeleportToEgg(egg) then
        CycleBusy = false
        CycleState = "IDLE"
        Status.Text = "● BUSCANDO HUEVOS"
        return
    end

    Freeze()

    if not InstaTP then
        CycleBusy = false
        CycleState = "IDLE"
        Unfreeze()
        return
    end

    -- =========================================================
    -- 3. AGARRAR
    -- =========================================================
    CycleState = "GRABBING"
    Status.Text = "● AGARRANDO"

    local grabbed = AutoGrab(egg)

    if not grabbed then
        CycleBusy = false
        CycleState = "IDLE"
        Status.Text = "● BUSCANDO HUEVOS"
        Unfreeze()
        return
    end

    -- Marcar el huevo procesado. Puede volver a detectarse si
    -- posteriormente se suelta y cambia de posición.
    EggCache[egg] = nil

    HeldEggs[egg] = {
        position = GetPosition(egg),
        time = os.clock()
    }

    if BestEgg == egg then
        BestEgg = nil
        BestLuck = 0
    end

    -- =========================================================
    -- 4. REGRESAR AL RANCHO
    -- =========================================================
    CycleState = "RETURNING"
    ReturningToRanch = true

    Status.Text = "● REGRESANDO AL RANCHO"

    StopEggLock()

    -- IMPORTANTE: aquí NO se llama RefreshBestEgg().
    -- El objetivo queda bloqueado hasta completar el regreso.
    local returned = ReturnSpawn()

    task.wait(0.25)

    -- Confirmar que seguimos en la fase de regreso antes de
    -- desbloquear cualquier búsqueda.
    Unfreeze()

    ReturningToRanch = false

    if not returned then
        CycleState = "IDLE"
        CycleBusy = false
        Status.Text = "● NO SE ENCONTRÓ EL RANCHO"
        return
    end

    -- =========================================================
    -- 5. RECIÉN AQUÍ TERMINÓ EL CICLO
    -- =========================================================
    CycleState = "IDLE"
    CycleBusy = false

    Status.Text = LOP and "● LOOP ACTIVE" or "● READY"

    -- Ahora sí puede buscar OTRO huevo.
    if InstaTP and LOP then
        task.wait(0.35)

        if InstaTP and LOP and not ReturningToRanch then
            CycleState = "SEARCHING"
            Status.Text = "● BUSCANDO HUEVOS"

            RefreshBestEgg()
            UpdateUI()

            CycleState = "IDLE"
        end
    else
        UpdateUI()
    end

end

