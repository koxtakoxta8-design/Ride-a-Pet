                        0,
                        10
                    )
            }
        ):Play()

    else

        Minimized = false

        TweenService:Create(
            Main,
            TweenInfo.new(
                .35,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),
