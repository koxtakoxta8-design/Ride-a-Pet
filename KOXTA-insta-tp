local function LooksLikeEggObject(obj)
    if not obj or not obj.Parent then
        return false
    end

    local name = string.lower(tostring(obj.Name or ""))

    -- Primero: nombre de la instancia.
    if KnownEggNames[name] or string.find(name, "egg", 1, true) then
        return true
    end

    -- Segundo: revisar solo el propio objeto y sus hijos DIRECTOS.
    -- No recorrer todos sus descendientes.
    if obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")
    then
        local text = string.lower(tostring(obj.Text or ""))

        if string.find(text, "egg", 1, true)
            or string.find(text, "huevo", 1, true)
        then
            return true
        end
    end

    for _, child in ipairs(obj:GetChildren()) do
        if child:IsA("TextLabel")
            or child:IsA("TextButton")
            or child:IsA("TextBox")
        then
            local text = string.lower(tostring(child.Text or ""))

            if string.find(text, "egg", 1, true)
                or string.find(text, "huevo", 1, true)
            then
                return true
            end
        end
    end

    return false
end

local function RegisterEgg(obj)
    if obj and obj.Parent and LooksLikeEggObject(obj) then
        EggCache[obj] = true
    end
end

-- Un SOLO escaneo inicial de todo Workspace.
for _, obj in ipairs(Workspace:GetDescendants()) do
    RegisterEgg(obj)
end

-- Desde aquí solo procesamos objetos nuevos.
Workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        RegisterEgg(obj)

        -- Algunos huevos reciben nombre/hijos después de aparecer.
        task.wait(0.15)

        if obj.Parent then
            RegisterEgg(obj)
        end
    end)
end)

-- Limpieza barata cada 5 segundos.
-- No vuelve a recorrer Workspace.
task.spawn(function()
    while task.wait(5) do
        for obj in pairs(EggCache) do
            if not obj or not obj.Parent then
                EggCache[obj] = nil
            end
        end
    end
end)

local function IsValidEgg(obj)

    if not obj or not obj.Parent then
        return false
    end

    local eggRank = GetEggRank(obj)

    -- Do not let arbitrary objects enter the egg cache.
    if not eggRank then
        return false
    end

    local position = GetPosition(obj)

    if not position then
        return false
    end

    local root = GetRoot()

    if not root then
        return false
    end

    -- =========================================================
    -- 210 STUDS: SIN CAMBIOS
    -- =========================================================
    if (
        position - EXCLUSION_CENTER
    ).Magnitude <= EXCLUSION_RADIUS then
        return false
    end

    if (
        position - root.Position
    ).Magnitude > DETECTION_DISTANCE then
        return false
    end

    return true
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

--==============================================================
-- REDETECCIÓN DE HUEVOS SOLTADOS
--==============================================================
-- Solo vigila los huevos que acabamos de procesar. No vuelve a
-- escanear todo Workspace, por lo que no recupera los lagazos.

task.spawn(function()
    while task.wait(0.25) do

        for egg, info in pairs(HeldEggs) do

            if not egg or not egg.Parent then
                HeldEggs[egg] = nil

            else
                local position = GetPosition(egg)

                if position and info.position then

                    local moved =
                        (position - info.position).Magnitude

                    -- Si el mismo huevo cambió de lugar después de
                    -- haber sido soltado, vuelve al detector.
                    if moved >= 2 then

                        HeldEggs[egg] = nil
                        EggCache[egg] = true

                    end
                end
            end
        end
    end
end)

local function RefreshBestEgg()

    if CycleBusy or ReturningToRanch then
        return BestEgg
    end

    if CycleState ~= "IDLE" and CycleState ~= "SEARCHING" then
        return BestEgg
    end

    local best = nil
    local bestRank = -1

    for obj in pairs(EggCache) do

        if IsValidEgg(obj) then

            local rank = GetEggRank(obj)

            if rank and rank > bestRank then
                bestRank = rank
                best = obj
            end

        else
            EggCache[obj] = nil
        end
    end

    BestEgg = best

    if best then
        local data = GetEggData(best.Name)
        BestLuck =
            data and data.Luck
            or tostring(GetLiveEggLuck(best) or "N/A")
    else
        BestLuck = 0
    end

    return best
end

