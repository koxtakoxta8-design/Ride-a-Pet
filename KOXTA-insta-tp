--==============================================================
-- UTILIDADES
--==============================================================

local function ParseLuck(value)
    local text = tostring(value or ""):upper()
    local number = tonumber(string.match(text, "[%d%.]+"))

    if not number then
        return 0
    end

    if string.find(text, "T", 1, true) then
        return number * 1e12
    elseif string.find(text, "B", 1, true) then
        return number * 1e9
    elseif string.find(text, "M", 1, true) then
        return number * 1e6
    elseif string.find(text, "K", 1, true) then
        return number * 1e3
    end

    return number
end

local function GetEggData(name)
    if not name then
        return nil
    end

    if EggData[name] then
        return EggData[name]
    end

    local lower = string.lower(name)

    for eggName, data in pairs(EggData) do
        if string.find(
            lower,
            string.lower(eggName),
            1,
            true
        ) then
            return data
        end
    end

    return nil
end

local function GetRoot()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--==============================================================
-- CAPTURAR EL SPAWN CORRECTO DE ENTRADA
--==============================================================

local EntrySpawnCFrame = nil
local EntrySpawnLocation = nil
local EntryCaptured = false

local function CaptureEntrySpawn(character)
    if EntryCaptured or not character then
        return
    end

    local root = character:WaitForChild("HumanoidRootPart", 15)
    if not root then
        return
    end

    -- Busca el SpawnLocation más cercano al personaje en el momento
    -- en que aparece. Con 2 spawns, toma el que realmente corresponde
    -- a la posición de entrada, no simplemente el primero encontrado.
    local closestSpawn = nil
    local closestDistance = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.Enabled then
            local distance = (obj.Position - root.Position).Magnitude

            if distance < closestDistance then
                closestDistance = distance
                closestSpawn = obj
            end
        end
    end

    if closestSpawn then
        EntrySpawnLocation = closestSpawn
        EntrySpawnCFrame = closestSpawn.CFrame + Vector3.new(0, 3, 0)
    else
        -- Fallback: si el juego no expone SpawnLocation, usa el punto
        -- exacto donde apareció el personaje.
        EntrySpawnCFrame = root.CFrame
    end

    EntryCaptured = true
end

if LocalPlayer.Character then
    task.spawn(function()
        CaptureEntrySpawn(LocalPlayer.Character)
    end)
end

LocalPlayer.CharacterAdded:Connect(function(character)
    CaptureEntrySpawn(character)
end)

local function GetPart(obj)
    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart
        end

        return obj:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return nil
end

local function GetPosition(obj)
    local part = GetPart(obj)

    if part then
        return part.Position
    end

    return nil
end

--==============================================================
-- CACHE DE HUEVOS
--==============================================================

local EggCache = {}

local function RegisterEgg(obj)

    if not obj or not obj.Parent then
        return
    end

    if GetEggData(obj.Name) then
        EggCache[obj] = true
    end
end

local function RemoveEgg(obj)
    EggCache[obj] = nil
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    RegisterEgg(obj)
end

Workspace.DescendantAdded:Connect(function(obj)

    if GetEggData(obj.Name) then
        EggCache[obj] = true
    end

end)

Workspace.DescendantRemoving:Connect(function(obj)

    EggCache[obj] = nil

end)

--==============================================================
-- VALIDAR HUEVO
--==============================================================

local function IsValidEgg(obj)

    if not obj or not obj.Parent then
        return false
    end

    local data = GetEggData(obj.Name)

    if not data then
        return false
    end

    local position = GetPosition(obj)

    if not position then
        return false
    end

    local root = GetRoot()

    if not root then
        return false
    end

    if (
        position - EXCLUSION_CENTER
    ).Magnitude <= EXCLUSION_RADIUS then
        return false
    end

    if (
        position - root.Position
    ).Magnitude > DETECTION_DISTANCE then
        return false
    end

    return true
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function RefreshBestEgg()

    local best = nil
    local bestValue = -1

    for obj in pairs(EggCache) do

        if IsValidEgg(obj) then

            local data = GetEggData(obj.Name)

            if data then

                local value =
                    ParseLuck(data.Luck)

                if value > bestValue then
                    bestValue = value
                    best = obj
                end

            end

        else

            EggCache[obj] = nil

        end

    end

    BestEgg = best
    BestLuck = bestValue

    return best
end

--==============================================================
-- RESPawn REAL
--==============================================================

local function GetRespawnCFrame()

    -- Usa exclusivamente el SpawnLocation identificado al entrar.
    if EntrySpawnLocation and EntrySpawnLocation.Parent then
        return EntrySpawnLocation.CFrame + Vector3.new(0, 3, 0)
    end

    if EntrySpawnCFrame then
        return EntrySpawnCFrame
    end

    return nil
end

local function SaveSpawn()
    -- NO guarda la posición actual.
    -- Guarda únicamente el SpawnLocation elegido al entrar.
    SavedSpawnCFrame = GetRespawnCFrame()
end

--==============================================================
-- TP
--==============================================================

local function StopEggLock()
    if EggLockConnection then
        EggLockConnection:Disconnect()
        EggLockConnection = nil
    end
    EggLockCFrame = nil
end

local function TeleportToEgg(egg)

    local root = GetRoot()
    local position = GetPosition(egg)

    if not root or not position then
        return false
    end

    -- Detiene cualquier bloqueo anterior ANTES de crear el nuevo.
    StopEggLock()

    -- El TP ocurre primero.
    local targetCFrame =
        CFrame.new(
            position + Vector3.new(0, 2.5, 0)
        )

    root.CFrame = targetCFrame

    -- Cero movimiento al terminar el TP.
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    -- Guarda la posición y mantenla hasta terminar el Auto Grab.
    EggLockCFrame = targetCFrame

    EggLockConnection = RunService.Heartbeat:Connect(function()
        if not InstaTP or not EggLockCFrame then
            return
        end

        local currentRoot = GetRoot()
        if not currentRoot then
            return
        end

        currentRoot.CFrame = EggLockCFrame
        currentRoot.AssemblyLinearVelocity = Vector3.zero
        currentRoot.AssemblyAngularVelocity = Vector3.zero
    end)

    return true
end

local function ReturnSpawn()

    -- El bloqueo del huevo ya fue liberado por DoCycle.
    local root = GetRoot()

    if not root then
        return false
    end

    -- Siempre resuelve el respawn real/entrada.
    -- Nunca usa la posición donde estaba al activar INSTA STEAL.
    local respawnCFrame = SavedSpawnCFrame or GetRespawnCFrame()

    if not respawnCFrame then
        return false
    end

    root.CFrame = respawnCFrame
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    -- Segundo TP de seguridad para juegos que intentan mover al jugador
    -- inmediatamente después de recoger el huevo.
    task.wait(0.05)

    local currentRoot = GetRoot()
    if currentRoot then
        currentRoot.CFrame = respawnCFrame
        currentRoot.AssemblyLinearVelocity = Vector3.zero
        currentRoot.AssemblyAngularVelocity = Vector3.zero
    end

    return true
end

--==============================================================
-- FREEZE
--==============================================================

local function Freeze()

    local character = LocalPlayer.Character
    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if humanoid then
        humanoid.AutoRotate = false
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.JumpHeight = 0
    end

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

end

local function Unfreeze()

    local character = LocalPlayer.Character
    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.AutoRotate = true
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        humanoid.JumpHeight = 7.2
    end

end

--==============================================================
-- PROMPT
--==============================================================

local function FindGrabPrompt(egg)

    if not egg then
        return nil
    end

    for _, obj in ipairs(egg:GetDescendants()) do

        if obj:IsA("ProximityPrompt") then

            local text =
                string.lower(
                    tostring(obj.ActionText)
                    .. " "
                    .. tostring(obj.ObjectText)
                )

            if
                string.find(text, "grab", 1, true)
                or string.find(text, "pick", 1, true)
                or string.find(text, "collect", 1, true)
                or string.find(text, "recoger", 1, true)
                or string.find(text, "agarrar", 1, true)
                or string.find(text, "tomar", 1, true)
            then
                return obj
            end

        end

    end

    return nil
end

--==============================================================
-- AUTO GRAB x3
--==============================================================

local function AutoGrab(egg)

    local prompt =
        FindGrabPrompt(egg)

    if not prompt then
        return false
    end

    Freeze()

    pcall(function()
        prompt.HoldDuration = 0
    end)

    for i = 1, 3 do

        if not InstaTP then
            break
        end

        pcall(function()
            prompt:InputHoldBegin()
        end)

        task.wait(0.08)

        pcall(function()
            prompt:InputHoldEnd()
        end)

        task.wait(0.08)

    end

    return true
end

