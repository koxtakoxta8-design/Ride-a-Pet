local RanchRespawnCFrame = nil
local RanchRespawnCharacter = nil

--==============================================================
-- DETECTAR EL RANCHO DEL SERVIDOR ACTUAL
--==============================================================
-- No usamos coordenadas fijas ni el spawn central.
-- El juego ya sabe dónde debe aparecer el jugador al respawnear.
-- Aprovechamos esa posición y la actualizamos si el servidor cambia
-- el punto de respawn.

local function CaptureCurrentRanchSpawn(character)
    if not character then
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")
        or character:WaitForChild("HumanoidRootPart", 5)

    if not root then
        return
    end

    -- Esperar un instante evita capturar una posición intermedia
    -- durante la animación/teleport inicial del respawn.
    task.wait(0.35)

    if character.Parent and root.Parent then
        RanchRespawnCFrame = root.CFrame
        RanchRespawnCharacter = character
    end
end

local function FindRanchDeliveryPoint()
    -- El respawn aprendido sirve como ancla para encontrar el plot
    -- correcto de ESTE servidor. Luego buscamos dentro de esa zona
    -- el punto donde realmente se entrega el huevo.
    if not RanchRespawnCFrame then
        return nil
    end

    local anchor = RanchRespawnCFrame.Position
    local bestPrompt = nil
    local bestScore = -1

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Parent then

            local part = obj.Parent
            if not part:IsA("BasePart") then
                part = obj:FindFirstAncestorWhichIsA("BasePart")
            end

            if part then
                local distance = (part.Position - anchor).Magnitude

                -- Solo considera prompts del entorno del rancho.
                if distance <= 180 then

                    local text = string.lower(
                        tostring(obj.ActionText) .. " "
                        .. tostring(obj.ObjectText) .. " "
                        .. tostring(part.Name)
                    )

                    local score = 0

                    -- Prioridad al punto de colocar/entregar huevos.
                    if string.find(text, "place", 1, true)
                        or string.find(text, "poner", 1, true)
                        or string.find(text, "colocar", 1, true)
                        or string.find(text, "deposit", 1, true)
                        or string.find(text, "deliver", 1, true)
                    then
                        score += 100
                    end

                    if string.find(text, "egg", 1, true)
                        or string.find(text, "huevo", 1, true)
                    then
                        score += 80
                    end

                    if string.find(text, "nest", 1, true)
                        or string.find(text, "nido", 1, true)
                    then
                        score += 70
                    end

                    -- También reconoce nombres de partes del nido.
                    local partName = string.lower(tostring(part.Name))
                    if string.find(partName, "nest", 1, true)
                        or string.find(partName, "nido", 1, true)
                    then
                        score += 50
                    end

                    -- No elegir prompts de tiendas/otros servicios.
                    if string.find(text, "shop", 1, true)
                        or string.find(text, "buy", 1, true)
                        or string.find(text, "sell", 1, true)
                    then
                        score -= 100
                    end

                    -- Más cerca = ligeramente mejor.
                    score -= distance * 0.05

                    if score > bestScore then
                        bestScore = score
                        bestPrompt = part
                    end
                end
            end
        end
    end

    if bestPrompt and bestScore >= 30 then
        return bestPrompt.CFrame + Vector3.new(0, 3, 0)
    end

    return nil
end

local function GetRespawnCFrame()

    -- Si el personaje actual ya fue colocado por el juego en su
    -- rancho, esa es la referencia correcta para ESTE servidor.
    local character = LocalPlayer.Character

    if character and character.Parent then
        local root = character:FindFirstChild("HumanoidRootPart")

        if root then
            -- Si nunca capturamos el rancho de esta sesión,
            -- capturarlo desde el respawn actual.
            if not RanchRespawnCFrame then
                CaptureCurrentRanchSpawn(character)
            end
        end
    end

    -- Solo devolver la posición aprendida del respawn real.
    -- NO hacemos fallback a SpawnLocation, RespawnLocation,
    -- plot central ni coordenadas fijas.
    return RanchRespawnCFrame
end

-- Cada respawn vuelve a aprender el rancho del servidor actual.
LocalPlayer.CharacterAdded:Connect(function(character)
    RanchRespawnCFrame = nil
    RanchRespawnCharacter = character

    task.spawn(function()
        CaptureCurrentRanchSpawn(character)
    end)
end)

-- Si el personaje ya existe al ejecutar el script.
if LocalPlayer.Character then
    task.spawn(function()
        CaptureCurrentRanchSpawn(LocalPlayer.Character)
    end)
end

local function SaveSpawn()
    -- Ya no guarda la posición donde estaba el jugador.
    -- Guarda el CFrame del respawn real del jugador.
    SavedSpawnCFrame = GetRespawnCFrame()
end

