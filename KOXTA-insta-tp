--==============================================================
-- PERSONAJE
--==============================================================

local function getCharacter()

    local character = player.Character

    if not character then
        return nil,nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root then
        return character,nil
    end

    return character,root
end

--==============================================================
-- CONGELAR
--==============================================================

local savedFreeze = {}

local function freezeCharacter()

    local character,root = getCharacter()

    if not character or not root then
        return false
    end

    savedFreeze = {}

    for _,obj in ipairs(character:GetDescendants()) do

        if obj:IsA("BasePart") then

            savedFreeze[obj] = {
                Anchored = obj.Anchored,
                CanCollide = obj.CanCollide
            }

            obj.Anchored = true
        end
    end

    return true
end

local function unfreezeCharacter()

    for obj,data in pairs(savedFreeze) do

        if obj and obj.Parent then

            obj.Anchored = data.Anchored
            obj.CanCollide = data.CanCollide
        end
    end

    savedFreeze = {}
end

--==============================================================
-- PLOTS
--==============================================================

local function obtenerPlots()

    return workspace:FindFirstChild("Plots")
        or workspace:FindFirstChild("plots")
        or workspace:FindFirstChild("Bases")
        or workspace:FindFirstChild("bases")
end

--==============================================================
-- COMPROBAR PROPIETARIO
--==============================================================

local function esMiValor(valor)

    if valor == player then
        return true
    end

    if tostring(valor) == player.Name then
        return true
    end

    if tostring(valor) == player.DisplayName then
        return true
    end

    if tostring(valor) == tostring(player.UserId) then
        return true
    end

    return false
end

--==============================================================
-- BUSCAR MI PLOT
--==============================================================

local function buscarMiPlot()

    local plots = obtenerPlots()

    if not plots then
        return nil
    end

    for _,plot in ipairs(plots:GetChildren()) do

        --==========================================================
        -- ATRIBUTOS
        --==========================================================

        for nombre,valor in pairs(plot:GetAttributes()) do

            local n = string.lower(tostring(nombre))

            if n:find("owner",1,true)
            or n:find("player",1,true)
            or n:find("user",1,true) then

                if esMiValor(valor) then
                    return plot
                end
            end
        end

        --==========================================================
        -- VALUES
        --==========================================================

        for _,obj in ipairs(plot:GetDescendants()) do

            if obj:IsA("StringValue")
            or obj:IsA("ObjectValue")
            or obj:IsA("IntValue")
            or obj:IsA("NumberValue") then

                local nombre = string.lower(obj.Name)

                if nombre:find("owner",1,true)
                or nombre:find("player",1,true)
                or nombre:find("user",1,true) then

                    local ok,valor = pcall(function()
                        return obj.Value
                    end)

                    if ok and esMiValor(valor) then
                        return plot
                    end
                end
            end
        end

        --==========================================================
        -- NOMBRE DEL PLOT
        --==========================================================

        local nombrePlot = string.lower(plot.Name)

        if nombrePlot == string.lower(player.Name)
        or nombrePlot == string.lower(player.DisplayName) then

            return plot
        end
    end

    return nil
end

--==============================================================
-- ENCONTRAR SPAWN
--==============================================================

local function encontrarSpawn(plot)

    if not plot then
        return nil
    end

    --==========================================================
    -- SPAWNLOCATION
    --==========================================================

    for _,obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("SpawnLocation") then
            return obj
        end
    end

    --==========================================================
    -- NOMBRES EXACTOS
    --==========================================================

    local nombres = {
        ["spawn"] = true,
        ["plotspawn"] = true,
        ["spawnlocation"] = true,
        ["respawn"] = true,
        ["respawnpoint"] = true,
        ["homespawn"] = true,
        ["playerspawn"] = true,
        ["basespawn"] = true,
        ["spawnpart"] = true,
    }

    for _,obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("BasePart") then

            local nombre = string.lower(obj.Name)

            if nombres[nombre] then
                return obj
            end
        end
    end

    --==========================================================
    -- CUALQUIER PARTE CON SPAWN/RESPAWN
    --==========================================================

    for _,obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("BasePart") then

            local nombre = string.lower(obj.Name)

            if nombre:find("spawn",1,true)
            or nombre:find("respawn",1,true) then

                return obj
            end
        end
    end

    return nil
end

--==============================================================
-- TP A MI PLOT
--==============================================================

local function TP_MiPlot()

    local character,root = getCharacter()

    if not character or not root then
        return false
    end

    -- BUSCAR TU PLOT DE NUEVO
    local miPlot = buscarMiPlot()

    if not miPlot then

        warn("KOXTA: NO SE ENCONTRO TU PLOT")

        status.Text = "STATUS: ❌ PLOT NO ENCONTRADO"

        return false
    end

    -- BUSCAR EL SPAWN DE TU PLOT
    local spawn = encontrarSpawn(miPlot)

    if spawn then

        local destino =
            spawn.CFrame + Vector3.new(0,HEIGHT_OFFSET,0)

        -- TP AL DESTINO REAL
        root.CFrame = destino

        task.wait(0.05)

        -- SEGUNDA APLICACION PARA EVITAR QUE
        -- QUEDE EN LA POSICION DEL HUEVO
        if root and root.Parent then
            root.CFrame = destino
        end

        task.wait(0.05)

        if root and root.Parent then
            root.CFrame = destino
        end

        status.Text = "STATUS: ✓ MI PLOT"

        return true
    end

    --==========================================================
    -- SI NO HAY SPAWN, CENTRO DEL PLOT
    --==========================================================

    if miPlot:IsA("Model") then

        local destino =
            miPlot:GetPivot() + Vector3.new(0,5,0)

        root.CFrame = destino

        task.wait(0.05)

        if root and root.Parent then
            root.CFrame = destino
        end

        status.Text = "STATUS: ✓ PLOT"

        return true
    end

    status.Text = "STATUS: ❌ SIN SPAWN"

    return false
end

--==============================================================
-- DETECTAR POSIBLES HUEVOS
--==============================================================

local function pareceHuevo(obj)

    local nombre = string.lower(obj.Name)

    if nombre:find("egg",1,true)
    or nombre:find("huevo",1,true) then

        return true
    end

    return false
end

--==============================================================
-- OBTENER VALOR
--==============================================================

local function obtenerValor(obj)

    local mejorValor = -math.huge

    --==========================================================
    -- ATTRIBUTES
    --==========================================================

    for nombre,valor in pairs(obj:GetAttributes()) do

        local n = string.lower(tostring(nombre))

        if n:find("value",1,true)
        or n:find("price",1,true)
        or n:find("rarity",1,true)
        or n:find("luck",1,true)
        or n:find("chance",1,true)
        or n:find("worth",1,true) then

            local numero = tonumber(valor)

            if numero then

                if numero > mejorValor then
                    mejorValor = numero
                end
            end
        end
    end

    --==========================================================
    -- VALUES
    --==========================================================

    for _,v in ipairs(obj:GetDescendants()) do

        if v:IsA("IntValue")
        or v:IsA("NumberValue") then

            local nombre = string.lower(v.Name)

            if nombre:find("value",1,true)
            or nombre:find("price",1,true)
            or nombre:find("luck",1,true)
            or nombre:find("chance",1,true)
            or nombre:find("worth",1,true) then

                local numero = tonumber(v.Value)

                if numero and numero > mejorValor then
                    mejorValor = numero
                end
            end
        end
    end

    return mejorValor
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function buscarMejorHuevo()

    local character,root = getCharacter()

    if not root then
        return nil
    end

    local mejor = nil
    local mejorValor = -math.huge
    local mejorDistancia = math.huge

    for _,obj in ipairs(workspace:GetDescendants()) do

        if obj:IsA("Model")
        or obj:IsA("BasePart") then

            if pareceHuevo(obj) then

                local part = nil

                if obj:IsA("BasePart") then

                    part = obj

                else

                    part =
                        obj.PrimaryPart
                        or obj:FindFirstChildWhichIsA("BasePart",true)
                end

                if part then

                    local distancia =
                        (root.Position - part.Position).Magnitude

                    if distancia <= SEARCH_RADIUS then

                        local valor = obtenerValor(obj)

                        if valor > mejorValor then

                            mejor = obj
                            mejorValor = valor
                            mejorDistancia = distancia

                        elseif valor == mejorValor
                        and distancia < mejorDistancia then

                            mejor = obj
                            mejorDistancia = distancia
                        end
                    end
                end
            end
        end
    end

    return mejor
end

--==============================================================
-- PARTE PRINCIPAL
--==============================================================

local function obtenerParte(obj)

    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then

        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart",true)
    end

    return nil
end

--==============================================================
-- PROMPT
--==============================================================

local function encontrarPrompt(obj)

    if not obj then
        return nil
    end

    for _,v in ipairs(obj:GetDescendants()) do

        if v:IsA("ProximityPrompt") then
            return v
        end
    end

    return nil
end

--==============================================================
-- GRAB
--==============================================================

local function agarrarHuevo(huevo)

    local prompt = encontrarPrompt(huevo)

    if not prompt then

        warn(
            "KOXTA: No encontré ProximityPrompt en:",
            huevo:GetFullName()
        )

        return false
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)

    pcall(function()
        fireproximityprompt(prompt)
    end)

    return true
end

--==============================================================
-- AUTO STEAL
--==============================================================

local function ejecutarSteal()

    if BUSY then
        return
    end

    BUSY = true

    --==========================================================
    -- BUSCAR MEJOR HUEVO
    --==========================================================

    status.Text = "STATUS: BUSCANDO MEJOR HUEVO"

    local huevo = buscarMejorHuevo()

    if not huevo then

        status.Text = "STATUS: NO HAY HUEVO"

        BUSY = false

        return
    end

    local part = obtenerParte(huevo)

    if not part then

        BUSY = false

        return
    end

    --==========================================================
    -- TP AL HUEVO
    --==========================================================

    status.Text = "STATUS: TP AL MEJOR HUEVO"

    local character,root = getCharacter()

    if not root then

        BUSY = false

        return
    end

    root.CFrame =
        CFrame.new(
            part.Position +
            Vector3.new(0,HEIGHT_OFFSET,0)
        )

    task.wait(0.15)

    --==========================================================
    -- CONGELAR
    --==========================================================

    status.Text = "STATUS: CONGELADO • AGARRANDO"

    freezeCharacter()

    task.wait(0.1)

    --==========================================================
    -- AGARRAR
    --==========================================================

    agarrarHuevo(huevo)

    task.wait(0.35)

    --==========================================================
    -- DESCONGELAR
    --==========================================================

    unfreezeCharacter()

    --==========================================================
    -- VOLVER A TU PLOT
    --==========================================================

    status.Text = "STATUS: VOLVIENDO A MI PLOT"

    task.wait(0.1)

    local regreso = TP_MiPlot()

    if not regreso then

        status.Text =
            "STATUS: ❌ NO PUDE VOLVER AL PLOT"

    else

        status.Text =
            "STATUS: ✓ REGRESO A MI PLOT"
    end

    task.wait(0.5)

    BUSY = false
end

--==============================================================
-- AUTO STEAL LOOP
--==============================================================

task.spawn(function()

    while gui.Parent do

        if AUTO_STEAL and not BUSY then

            ejecutarSteal()
        end

        task.wait(0.5)
    end
end)

