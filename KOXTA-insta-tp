local function SaveAndHideInterface()
    InterfaceSaved = true

    -- Guarda la posición actual antes de ocultar.
    local savedPosition = Main.Position

    Main.Visible = false
    ReopenButton.Visible = true

    -- Al reabrir conserva exactamente la posición.
    ReopenButton:SetAttribute("SavedXScale", savedPosition.X.Scale)
    ReopenButton:SetAttribute("SavedXOffset", savedPosition.X.Offset)
    ReopenButton:SetAttribute("SavedYScale", savedPosition.Y.Scale)
    ReopenButton:SetAttribute("SavedYOffset", savedPosition.Y.Offset)
end

local function ReopenInterface()
    if not InterfaceSaved then
        return
    end

    local xs = ReopenButton:GetAttribute("SavedXScale") or 0
    local xo = ReopenButton:GetAttribute("SavedXOffset") or 0
    local ys = ReopenButton:GetAttribute("SavedYScale") or 0
    local yo = ReopenButton:GetAttribute("SavedYOffset") or 0

    Main.Position = UDim2.new(xs, xo, ys, yo)
    Main.Visible = true
    ReopenButton.Visible = false
end

