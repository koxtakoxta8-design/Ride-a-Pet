--==============================================================
-- PERSONAJE
--==============================================================

local function getRoot()

    local character = player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--==============================================================
-- TU CODIGO DE PLOT
--==============================================================

local function buscarMiPlot()

    local plots = workspace:FindFirstChild("Plots")
        or workspace:FindFirstChild("plots")
        or workspace:FindFirstChild("Bases")
        or workspace:FindFirstChild("bases")

    if not plots then
        return nil
    end

    for _, plot in ipairs(plots:GetChildren()) do

        -- BUSCAR TU NOMBRE EN ATRIBUTOS
        for _, atributo in ipairs({
            "Owner",
            "OwnerName",
            "Player",
            "PlayerName",
            "UserId"
        }) do

            local valor = plot:GetAttribute(atributo)

            if valor and (
                tostring(valor) == player.Name
                or tostring(valor) == tostring(player.UserId)
            ) then

                return plot
            end
        end

        -- BUSCAR VALUE DENTRO DEL PLOT
        for _, obj in ipairs(plot:GetDescendants()) do

            if obj:IsA("StringValue")
            or obj:IsA("ObjectValue") then

                if obj.Value == player.Name
                or obj.Value == player then

                    return plot
                end
            end
        end
    end

    return nil
end

--==============================================================
-- TU CODIGO DE SPAWN
--==============================================================

local function encontrarSpawn(plot)

    for _, obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("SpawnLocation") then
            return obj
        end

        if obj:IsA("BasePart") then

            local nombre = obj.Name:lower()

            if nombre == "spawn"
            or nombre == "plotspawn"
            or nombre == "spawnlocation"
            or nombre == "respawn" then

                return obj
            end
        end
    end

    return nil
end

--==============================================================
-- TU TP AL PLOT
--==============================================================

local function TP_MiPlot()

    local root = getRoot()

    if not root then
        return false
    end

    local miPlot = buscarMiPlot()

    if not miPlot then
        return false
    end

    local spawn = encontrarSpawn(miPlot)

    if not spawn then
        return false
    end

    root.CFrame = spawn.CFrame + Vector3.new(0,4,0)

    return true
end

--==============================================================
-- CONGELAR
--==============================================================

local function congelar(root)

    if not root then
        return
    end

    root.Anchored = true
end

local function descongelar(root)

    if not root then
        return
    end

    root.Anchored = false
end

--==============================================================
-- BUSCAR PROMPT
--==============================================================

local function buscarPrompt(obj)

    if not obj then
        return nil
    end

    for _, v in ipairs(obj:GetDescendants()) do

        if v:IsA("ProximityPrompt") then
            return v
        end
    end

    return nil
end

--==============================================================
-- AGARRAR
--==============================================================

local function agarrar(obj)

    local prompt = buscarPrompt(obj)

    if not prompt then
        return false
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)

    pcall(function()
        fireproximityprompt(prompt)
    end)

    return true
end

--==============================================================
-- ENCONTRAR MEJOR HUEVO
--
-- IMPORTANTE:
-- Aquí debe ir EXACTAMENTE tu función de detección
-- del mejor huevo que ya tienes funcionando.
--==============================================================

local function buscarMejorHuevo()

    -- Busca objetos llamados Egg/Huevo.
    -- Si tu script anterior ya tiene esta función,
    -- reemplaza SOLO esta función por la tuya.

    local mejor = nil

    for _,obj in ipairs(workspace:GetDescendants()) do

        local nombre = obj.Name:lower()

        if nombre:find("egg")
        or nombre:find("huevo") then

            if obj:IsA("Model")
            or obj:IsA("BasePart") then

                mejor = obj

                -- No se altera tu sistema de TP al Plot.
                -- Esta función queda preparada para conectar
                -- tu detector real de mejor huevo.

                break
            end
        end
    end

    return mejor
end

--==============================================================
-- AUTO STEAL
--==============================================================

local function hacerAutoSteal()

    if Working then
        return
    end

    Working = true

    local root = getRoot()

    if not root then
        Working = false
        return
    end

    -- BUSCAR HUEVO
    status.Text = "STATUS: BUSCANDO HUEVO"

    local huevo = buscarMejorHuevo()

    if not huevo then

        status.Text = "STATUS: SIN HUEVO"

        Working = false
        return
    end

    -- OBTENER PARTE
    local parte

    if huevo:IsA("BasePart") then
        parte = huevo
    else
        parte =
            huevo.PrimaryPart
            or huevo:FindFirstChildWhichIsA("BasePart",true)
    end

    if not parte then
        Working = false
        return
    end

    --==========================================================
    -- TP AL HUEVO
    --==========================================================

    status.Text = "STATUS: TP AL HUEVO"

    root.CFrame =
        CFrame.new(parte.Position + Vector3.new(0,4,0))

    task.wait(0.15)

    --==========================================================
    -- CONGELAR
    --==========================================================

    status.Text = "STATUS: CONGELADO • AGARRANDO"

    congelar(root)

    task.wait(0.1)

    --==========================================================
    -- AGARRAR
    --==========================================================

    agarrar(huevo)

    task.wait(0.4)

    --==========================================================
    -- DESCONGELAR
    --==========================================================

    descongelar(root)

    --==========================================================
    -- TP A TU PLOT
    --==========================================================

    status.Text = "STATUS: VOLVIENDO AL PLOT"

    task.wait(0.1)

    TP_MiPlot()

    task.wait(0.5)

    Working = false
end

--==============================================================
-- AUTO LOOP
--==============================================================

task.spawn(function()

    while gui.Parent do

        if AutoSteal and not Working then
            hacerAutoSteal()
        end

        task.wait(0.4)
    end
end)

