--==============================================================
-- UTILIDADES
--==============================================================

local function GetRoot()
    local Character = Player.Character
    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function GetPosition(Object)
    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then
        if Object.PrimaryPart then
            return Object.PrimaryPart.Position
        end

        -- One-time fallback. RegisterEgg stores the result, so this is
        -- not repeated on every selector pass.
        local Part = Object:FindFirstChildWhichIsA("BasePart", true)
        return Part and Part.Position
    end

    return nil
end

local function IsExcluded(Position)

    if not Position then
        return true
    end

    local X = math.abs(
        Position.X - EXCLUSION_CENTER.X
    )

    local Z = math.abs(
        Position.Z - EXCLUSION_CENTER.Z
    )

    return X <= EXCLUSION_RADIUS
       and Z <= EXCLUSION_RADIUS
end

local function IsEgg(Object)
    if not Object then
        return false
    end

    if Object:IsA("ProximityPrompt") then
        return GetEggFromPrompt(Object) ~= nil
    end

    return LooksLikeEggName(Object.Name)
        or Object:GetAttribute("IsEgg") == true
        or Object:GetAttribute("Egg") == true
end

local function FindPrompt(Object)
    if not Object then
        return nil
    end

    if Object:IsA("ProximityPrompt") then
        return Object
    end

    return Object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

--==============================================================
-- VALOR
--==============================================================

local function GetValue(Object)
    if not Object then
        return 0
    end

    -- Prefer direct attributes: cheap and stable.
    local AttributeNames = {
        "Luck",
        "luck",
        "EggLuck",
        "RarityValue",
        "Value",
        "Price"
    }

    for _, Name in ipairs(AttributeNames) do
        local Value = Object:GetAttribute(Name)
        if typeof(Value) == "number" then
            return Value
        end
    end

    -- Only inspect direct children. Never recursively scan the whole egg
    -- during the selector loop.
    for _, Item in ipairs(Object:GetChildren()) do
        if Item:IsA("NumberValue") or Item:IsA("IntValue") then
            local Name = Item.Name:lower()

            if Name:find("luck", 1, true)
            or Name:find("rarity", 1, true)
            or Name:find("value", 1, true)
            or Name:find("price", 1, true) then
                return Item.Value
            end
        end
    end

    return 0
end

--==============================================================
-- PRIORIDAD DE HUEVOS
--==============================================================

local EggPriority = {
    ["White Egg"] = 1, ["Brown Egg"] = 5, ["Cracked Egg"] = 30,
    ["Easter Egg"] = 50, ["Stone Egg"] = 100, ["Leaf Egg"] = 200,
    ["Mushroom Egg"] = 500, ["Flower Egg"] = 750, ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000, ["Glass Egg"] = 10000, ["Golden Egg"] = 30000,
    ["Crystal Egg"] = 150000, ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000, ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000, ["Soul Egg"] = 7000000,
    ["Aurora Egg"] = 300000000, ["Galaxy Egg"] = 1500000000,
    ["Blackhole Egg"] = 100000000000, ["Solaris Egg"] = 300000000000,
    ["Cherub Egg"] = 1000000000000, ["Volcanic Egg"] = 2500000000000
}

local function GetEggPriority(Object)
    return Object and EggPriority[Object.Name] or 0
end

local function LooksLikeEggName(name)
    return EggPriority[tostring(name or "")] ~= nil
end

local function GetEggFromPrompt(Prompt)
    if not Prompt then return nil end
    local current = Prompt.Parent

    for _ = 1, 12 do
        if not current then break end
        if LooksLikeEggName(current.Name) then
            return current
        end
        current = current.Parent
    end

    return nil
end

--==============================================================
-- CACHE DE HUEVOS
--==============================================================

-- Solo 1 representante por cada tipo de huevo.
-- Ej.: 10 Volcanic -> se guarda 1 Volcanic.
local EggByType = {}
local EggCache = {}
local CachedPlotPosition = nil

local function RegisterEgg(Object)
    if not Object or not Object.Parent then
        return false
    end

    local Egg = Object

    if Object:IsA("ProximityPrompt") then
        local Current = Object.Parent

        for _ = 1, 12 do
            if not Current then
                break
            end

            if EggPriority[Current.Name] then
                Egg = Current
                break
            end

            Current = Current.Parent
        end
    end

    if not Egg
    or not Egg.Parent
    or not EggPriority[Egg.Name] then
        return false
    end

    local EggType = Egg.Name

    -- Ya tenemos un representante válido de este tipo.
    if EggByType[EggType]
    and EggByType[EggType].Object
    and EggByType[EggType].Object.Parent then
        return false
    end

    local Position = GetPosition(Egg)

    if not Position or IsExcluded(Position) then
        return false
    end

    local Prompt = FindPrompt(Egg)

    if not Prompt then
        return false
    end

    local Priority = EggPriority[EggType]

    local Data = {
        Object = Egg,
        Position = Position,
        Prompt = Prompt,
        Value = Priority,
        Priority = Priority,
        EggType = EggType
    }

    EggByType[EggType] = Data
    EggCache[Egg] = Data

    return true
end

local function RemoveEgg(Egg)
    if not Egg then
        return
    end

    local EggType = Egg.Name
    local Data = EggByType[EggType]

    if Data and Data.Object == Egg then
        EggByType[EggType] = nil
        EggCache[Egg] = nil

        -- Si todavía existe otro del mismo tipo, toma SOLO uno.
        task.defer(function()
            if EggByType[EggType] then
                return
            end

            for _, Candidate in ipairs(workspace:GetDescendants()) do
                if Candidate ~= Egg
                and Candidate.Parent
                and Candidate.Name == EggType then
                    if RegisterEgg(Candidate) then
                        break
                    end
                end
            end
        end)
    end
end

local function RebuildCache()
    table.clear(EggByType)
    table.clear(EggCache)

    -- Un único escaneo inicial.
    -- En cuanto ya existe un tipo, los duplicados se ignoran.
    for _, Object in ipairs(workspace:GetDescendants()) do
        if EggPriority[Object.Name]
        and not EggByType[Object.Name] then
            RegisterEgg(Object)
        end
    end
end

