local function StopEggLock()
    if EggLockConnection then
        EggLockConnection:Disconnect()
        EggLockConnection = nil
    end
    EggLockCFrame = nil
end

local function TeleportToEgg(egg)

    local root = GetRoot()
    local position = GetPosition(egg)

    if not root or not position then
        return false
    end

    -- Detiene cualquier bloqueo anterior ANTES de crear el nuevo.
    StopEggLock()

    -- El TP ocurre primero.
    local targetCFrame =
        CFrame.new(
            position + Vector3.new(0, 2.5, 0)
        )

    root.CFrame = targetCFrame

    -- Cero movimiento al terminar el TP.
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    -- Guarda la posición y mantenla hasta terminar el Auto Grab.
    EggLockCFrame = targetCFrame

    EggLockConnection = RunService.Heartbeat:Connect(function()
        if not InstaTP or not EggLockCFrame then
            return
        end

        local currentRoot = GetRoot()
        if not currentRoot then
            return
        end

        currentRoot.CFrame = EggLockCFrame
        currentRoot.AssemblyLinearVelocity = Vector3.zero
        currentRoot.AssemblyAngularVelocity = Vector3.zero
    end)

    return true
end

local function ReturnSpawn()

    local root = GetRoot()

    if not root then
        return false
    end

    -- IMPORTANTE:
    -- No recalcular BestEgg ni buscar otro huevo durante el regreso.
    -- Primero intentamos usar el punto de entrega del RANCHO aprendido
    -- para este servidor. Si no existe, usamos el respawn del mismo rancho.
    local targetCFrame = FindRanchDeliveryPoint()

    if not targetCFrame then
        targetCFrame = SavedSpawnCFrame
    end

    if not targetCFrame then
        return false
    end

    local targetPosition = targetCFrame.Position

    -- Protección contra el spawn central.
    if (targetPosition - SPAWN_NO_TP_CENTER).Magnitude <= SPAWN_NO_TP_RADIUS then
        return false
    end

    -- Congelar el objetivo de regreso antes de mover al personaje.
    -- Así ningún cambio de BestEgg puede modificar este TP.
    root.CFrame = targetCFrame
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    -- Esperar un frame y reafirmar la misma posición.
    -- No se hace ningún RefreshBestEgg aquí.
    task.wait()

    if root.Parent then
        root.CFrame = targetCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    return true
end

--==============================================================
-- FREEZE
--==============================================================

local function Freeze()

    local character = LocalPlayer.Character
    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if humanoid then
        humanoid.AutoRotate = false
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.JumpHeight = 0
    end

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

end

local function Unfreeze()

    local character = LocalPlayer.Character
    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.AutoRotate = true
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        humanoid.JumpHeight = 7.2
    end

end

