--==============================================================
-- CICLO
--==============================================================

local function DoCycle()

    if not InstaTP then
        return
    end

    RefreshBestEgg()
    UpdateUI()

    local egg = BestEgg

    if not egg then
        Status.Text = "● SIN HUEVO"
        return
    end

    Status.Text = "● TELEPORT"

    if not TeleportToEgg(egg) then
        return
    end

    -- Se congela inmediatamente después del TP; no hay ventana de movimiento.
    Freeze()

    if not InstaTP then
        Unfreeze()
        return
    end

    Status.Text = "● AUTO GRAB"

    -- Primero intenta agarrar el huevo.
    local grabbed = AutoGrab(egg)

    if not grabbed then
        Status.Text = "● NO SE PUDO AGARRAR"
        Unfreeze()
        return
    end

    -- Espera breve para que termine el agarre antes de regresar.
    task.wait(0.25)

    if not InstaTP then
        StopEggLock()
        Unfreeze()
        return
    end

    -- Secuencia: TP al mejor huevo → agarrar → TP al respawn.
    Status.Text = "● RETURN"

    -- MUY IMPORTANTE:
    -- primero se libera completamente el bloqueo que mantenía
    -- al personaje pegado al huevo.
    StopEggLock()

    -- Ahora se permite el movimiento normal antes del TP de regreso.
    Unfreeze()

    task.wait(0.05)

    -- TP al respawn/entrada, no a la posición anterior.
    local returned = ReturnSpawn()

    task.wait(0.15)

    Status.Text =
        returned and (LOP and "● LOOP ACTIVE" or "● READY")
        or "● SPAWN NO GUARDADO"

end

