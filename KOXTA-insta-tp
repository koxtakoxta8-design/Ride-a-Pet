--==============================================================
-- PERSONAJE
--==============================================================

local function getRoot()

    local character = player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

--==============================================================
-- BUSCAR MI PLOT
--==============================================================

local function buscarMiPlot()

    local contenedores = {
        workspace:FindFirstChild("Plots"),
        workspace:FindFirstChild("plots"),
        workspace:FindFirstChild("Bases"),
        workspace:FindFirstChild("bases"),
    }

    for _, contenedor in ipairs(contenedores) do

        if contenedor then

            for _, plot in ipairs(contenedor:GetChildren()) do

                --==================================================
                -- ATRIBUTOS
                --==================================================

                local atributos = {
                    "Owner",
                    "OwnerName",
                    "Player",
                    "PlayerName",
                    "Username",
                    "UserName",
                    "UserId",
                    "OwnerUserId",
                    "OwnerId",
                }

                for _, atributo in ipairs(atributos) do

                    local valor = plot:GetAttribute(atributo)

                    if valor ~= nil then

                        local texto = tostring(valor)

                        if texto == player.Name
                        or texto == player.DisplayName
                        or texto == tostring(player.UserId) then

                            return plot
                        end
                    end
                end

                --==================================================
                -- VALUES
                --==================================================

                for _, obj in ipairs(plot:GetDescendants()) do

                    if obj:IsA("StringValue") then

                        local valor = tostring(obj.Value)

                        if valor == player.Name
                        or valor == player.DisplayName
                        or valor == tostring(player.UserId) then

                            return plot
                        end

                    elseif obj:IsA("ObjectValue") then

                        if obj.Value == player then
                            return plot
                        end

                    elseif obj:IsA("IntValue")
                    or obj:IsA("NumberValue") then

                        if tostring(obj.Value) == tostring(player.UserId) then
                            return plot
                        end
                    end
                end

                --==================================================
                -- MODELO CON TU NOMBRE
                --==================================================

                for _, obj in ipairs(plot:GetDescendants()) do

                    if obj:IsA("Model") then

                        if obj.Name == player.Name
                        or obj.Name == player.DisplayName then

                            return plot
                        end
                    end
                end

                --==================================================
                -- NOMBRE DEL PLOT
                --==================================================

                local nombrePlot = plot.Name:lower()

                local nombreJugador = player.Name:lower()
                local displayJugador = player.DisplayName:lower()

                if nombrePlot:find(nombreJugador,1,true)
                or nombrePlot:find(displayJugador,1,true) then

                    return plot
                end
            end
        end
    end

    return nil
end

--==============================================================
-- BUSCAR SPAWN DEL PLOT
--==============================================================

local function encontrarSpawn(plot)

    if not plot then
        return nil
    end

    -- Nombres conocidos
    local nombres = {
        "Spawn",
        "PlotSpawn",
        "SpawnLocation",
        "Respawn",
        "PlayerSpawn",
        "HomeSpawn",
        "BaseSpawn",
        "SpawnPoint",
        "SpawnPart",
    }

    -- Buscar por nombre
    for _, nombre in ipairs(nombres) do

        local obj = plot:FindFirstChild(nombre,true)

        if obj and obj:IsA("BasePart") then
            return obj
        end
    end

    -- SpawnLocation
    for _, obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("SpawnLocation") then
            return obj
        end
    end

    -- Cualquier parte que tenga spawn/respawn
    for _, obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("BasePart") then

            local nombre = obj.Name:lower()

            if nombre:find("spawn",1,true)
            or nombre:find("respawn",1,true) then

                return obj
            end
        end
    end

    return nil
end

--==============================================================
-- TP A MI PLOT
--==============================================================

local function TP_MiPlot()

    local root = getRoot()

    if not root then
        return false
    end

    local miPlot = buscarMiPlot()

    if not miPlot then
        return false
    end

    local spawn = encontrarSpawn(miPlot)

    if not spawn then
        return false
    end

    root.CFrame = spawn.CFrame + Vector3.new(0,4,0)

    return true
end

--==============================================================
-- CONGELAR
--==============================================================

local function congelar(root)

    if not root then
        return
    end

    root.Anchored = true
end

local function descongelar(root)

    if not root then
        return
    end

    root.Anchored = false
end

--==============================================================
-- BUSCAR PROMPT
--==============================================================

local function buscarPrompt(obj)

    if not obj then
        return nil
    end

    for _, v in ipairs(obj:GetDescendants()) do

        if v:IsA("ProximityPrompt") then
            return v
        end
    end

    return nil
end

--==============================================================
-- AGARRAR
--==============================================================

local function agarrar(obj)

    local prompt = buscarPrompt(obj)

    if not prompt then
        return false
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)

    pcall(function()
        fireproximityprompt(prompt)
    end)

    return true
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function buscarMejorHuevo()

    local mejor = nil

    for _,obj in ipairs(workspace:GetDescendants()) do

        local nombre = obj.Name:lower()

        if nombre:find("egg",1,true)
        or nombre:find("huevo",1,true) then

            if obj:IsA("Model")
            or obj:IsA("BasePart") then

                mejor = obj
                break
            end
        end
    end

    return mejor
end

--==============================================================
-- AUTO STEAL
--==============================================================

local function hacerAutoSteal()

    if Working then
        return
    end

    Working = true

    local root = getRoot()

    if not root then
        Working = false
        return
    end

    --==========================================================
    -- BUSCAR HUEVO
    --==========================================================

    status.Text = "STATUS: BUSCANDO HUEVO"

    local huevo = buscarMejorHuevo()

    if not huevo then

        status.Text = "STATUS: SIN HUEVO"

        Working = false
        return
    end

    --==========================================================
    -- OBTENER PARTE
    --==========================================================

    local parte

    if huevo:IsA("BasePart") then

        parte = huevo

    else

        parte =
            huevo.PrimaryPart
            or huevo:FindFirstChildWhichIsA("BasePart",true)
    end

    if not parte then

        Working = false
        return
    end

    --==========================================================
    -- TP AL HUEVO
    --==========================================================

    status.Text = "STATUS: TP AL HUEVO"

    root.CFrame =
        CFrame.new(parte.Position + Vector3.new(0,4,0))

    task.wait(0.15)

    --==========================================================
    -- CONGELAR
    --==========================================================

    status.Text = "STATUS: CONGELADO • AGARRANDO"

    congelar(root)

    task.wait(0.1)

    --==========================================================
    -- AGARRAR
    --==========================================================

    agarrar(huevo)

    task.wait(0.4)

    --==========================================================
    -- DESCONGELAR
    --==========================================================

    descongelar(root)

    --==========================================================
    -- TP A TU PLOT
    --==========================================================

    status.Text = "STATUS: VOLVIENDO AL PLOT"

    task.wait(0.1)

    local regreso = TP_MiPlot()

    if not regreso then
        status.Text = "STATUS: ❌ NO ENCONTRE TU PLOT"
    else
        status.Text = "STATUS: ✓ REGRESO AL PLOT"
    end

    task.wait(0.5)

    Working = false
end

--==============================================================
-- AUTO LOOP
--==============================================================

task.spawn(function()

    while gui.Parent do

        if AutoSteal and not Working then
            hacerAutoSteal()
        end

        task.wait(0.4)
    end
end)

