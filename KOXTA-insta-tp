--==============================================================
-- RECOGER x5
--==============================================================

local function WaitForPrompt(EggObject, Timeout)
    local Deadline = os.clock() + (Timeout or 0.8)

    while EggObject and EggObject.Parent and os.clock() < Deadline do
        local Prompt = FindPrompt(EggObject)
        if Prompt and Prompt.Parent then
            return Prompt
        end
        task.wait(0.05)
    end

    return nil
end

local function ActivatePrompt(Prompt)
    if not Prompt or not Prompt.Parent then
        return false
    end

    if typeof(fireproximityprompt) == "function" then
        local ok = pcall(function()
            Prompt.HoldDuration = 0
            fireproximityprompt(Prompt)
        end)
        if ok then
            return true
        end
    end

    local ok = pcall(function()
        Prompt.HoldDuration = 0
        Prompt:InputHoldBegin()
        task.wait(PROMPT_DELAY)
        Prompt:InputHoldEnd()
    end)

    return ok
end

local function WaitUntilCollected(EggObject, Timeout)
    local Deadline = os.clock() + (Timeout or 0.65)

    while EggObject
    and EggObject.Parent
    and os.clock() < Deadline do
        task.wait(0.05)
    end

    return not EggObject or not EggObject.Parent
end

local function BurstCollect(Egg)
    if not Egg or not Egg.Object or not Egg.Object.Parent then
        return false
    end

    local Activated = false

    -- No hacemos 5 disparos seguidos. Primero intentamos recoger una vez.
    -- Si el juego no procesó la recogida, reintentamos después de esperar.
    for i = 1, BURST_COUNT do
        if not Egg.Object or not Egg.Object.Parent then
            return true
        end

        local Prompt = FindPrompt(Egg.Object)

        if not Prompt or not Prompt.Parent then
            Prompt = WaitForPrompt(Egg.Object, 0.25)
        end

        if not Prompt then
            task.wait(0.08)
            continue
        end

        Egg.Prompt = Prompt
        StatusLabel.Text = "Estado: AUTO GRAB " .. i .. "/" .. BURST_COUNT

        -- Esperar hasta que el prompt esté realmente habilitado.
        local ReadyDeadline = os.clock() + 0.18

        while Prompt.Parent
        and not Prompt.Enabled
        and os.clock() < ReadyDeadline do
            task.wait(0.03)
        end

        if not Prompt.Parent then
            continue
        end

        if ActivatePrompt(Prompt) then
            Activated = true
        end

        -- Importante: no volver a disparar inmediatamente.
        -- Dejamos que el juego procese la recogida.
        if WaitUntilCollected(Egg.Object, 0.45) then
            return true
        end

        -- Sigue existiendo: refrescar prompt y probar nuevamente.
        task.wait(0.04)
    end

    return Activated and (not Egg.Object or not Egg.Object.Parent)
end

--==============================================================
-- BUSCAR PLOT
--==============================================================

local function IsMyPlot(Object)

    for _,Name in ipairs({
        "Owner",
        "owner",
        "OwnerName",
        "ownerName"
    }) do

        local Attribute =
            Object:GetAttribute(Name)

        if Attribute ~= nil then

            if tostring(Attribute)
                == Player.Name
            or tostring(Attribute)
                == tostring(Player.UserId) then

                return true
            end
        end

        local Value =
            Object:FindFirstChild(
                Name,
                true
            )

        if Value then

            if Value:IsA("StringValue")
            and Value.Value == Player.Name then

                return true
            end

            if Value:IsA("IntValue")
            and Value.Value == Player.UserId then

                return true
            end

            if Value:IsA("ObjectValue")
            and Value.Value == Player then

                return true
            end
        end
    end

    return false
end

local function FindMyPlot()
    if CachedPlotPosition then
        return CachedPlotPosition
    end

    -- Only the first lookup scans Workspace.
    for _, Object in ipairs(workspace:GetDescendants()) do
        local Name = Object.Name:lower()

        if Name:find("plot", 1, true)
        or Name:find("tycoon", 1, true)
        or Name:find("base", 1, true) then

            if IsMyPlot(Object) then
                local Position = GetPosition(Object)

                if Position then
                    CachedPlotPosition = Position
                    return Position
                end
            end
        end
    end

    return nil
end

--==============================================================
-- UN CICLO
--==============================================================

local function RunOnce()
    if BUSY then return false end
    BUSY = true

    StatusLabel.Text = "Estado: BUSCANDO"

    local Egg = FindBestEggFast()

    if not Egg then
        BestLabel.Text = "🏆 Mejor: NINGUNO"
        StatusLabel.Text = "Estado: SIN HUEVO"
        BUSY = false
        return false
    end

    BestLabel.Text = "🏆 Mejor: " .. Egg.Object.Name

    local Position = GetPosition(Egg.Object)
    if not Position then
        StatusLabel.Text = "Estado: ACTUALIZANDO HUEVO"
        BUSY = false
        return false
    end

    Egg.Position = Position

    if IsExcluded(Position) then
        StatusLabel.Text = "Estado: HUEVO EXCLUIDO"
        BUSY = false
        return false
    end

    StatusLabel.Text = "Estado: TP AL HUEVO"

    if not Teleport(Position) then
        StatusLabel.Text = "Estado: TP FALLÓ"
        BUSY = false
        return false
    end

    task.wait(0.025)

    local Collected = BurstCollect(Egg)

    if not Egg.Object.Parent then
        if EggByType[Egg.EggType]
        and EggByType[Egg.EggType].Object == Egg.Object then
            EggByType[Egg.EggType] = nil
        end
        EggCache[Egg.Object] = nil
    end

    task.wait(0.015)

    local Plot = FindMyPlot()
    if Plot then
        StatusLabel.Text = "Estado: TP AL PLOT"
        Teleport(Plot)
        task.wait(0.03)
        StatusLabel.Text = Collected
            and "Estado: COMPLETADO"
            or "Estado: AUTO GRAB NO CONFIRMADO"
    else
        StatusLabel.Text = Collected
            and "Estado: HUEVO RECOGIDO"
            or "Estado: AUTO GRAB NO CONFIRMADO"
    end

    BUSY = false
    return Collected
end

