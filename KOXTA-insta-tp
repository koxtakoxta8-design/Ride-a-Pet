--==============================================================
-- PERSONAJE
--==============================================================

local function getCharacter()

    local character = player.Character

    if not character then
        return nil,nil
    end

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not root then
        return character,nil
    end

    return character,root
end

--==============================================================
-- CONGELAR
--==============================================================

local savedFreeze = {}

local function freezeCharacter()

    local character,root = getCharacter()

    if not character or not root then
        return false
    end

    savedFreeze = {}

    for _,obj in ipairs(character:GetDescendants()) do

        if obj:IsA("BasePart") then

            savedFreeze[obj] = {
                Anchored = obj.Anchored,
                CanCollide = obj.CanCollide
            }

            obj.Anchored = true
        end
    end

    return true
end

--==============================================================
-- DESCONGELAR
--==============================================================

local function unfreezeCharacter()

    for obj,data in pairs(savedFreeze) do

        if obj and obj.Parent then

            obj.Anchored = data.Anchored
            obj.CanCollide = data.CanCollide
        end
    end

    savedFreeze = {}
end

--==============================================================
-- DETECTAR HUEVO
--==============================================================

local function pareceHuevo(obj)

    local nombre =
        string.lower(obj.Name)

    if nombre:find("egg",1,true)
    or nombre:find("huevo",1,true) then

        return true
    end

    return false
end

--==============================================================
-- OBTENER VALOR DEL HUEVO
--==============================================================

local function obtenerValor(obj)

    local mejorValor = -math.huge

    --==========================================================
    -- ATTRIBUTES
    --==========================================================

    for nombre,valor in pairs(obj:GetAttributes()) do

        local n =
            string.lower(tostring(nombre))

        if n:find("value",1,true)
        or n:find("price",1,true)
        or n:find("rarity",1,true)
        or n:find("luck",1,true)
        or n:find("chance",1,true)
        or n:find("worth",1,true) then

            local numero =
                tonumber(valor)

            if numero then

                mejorValor =
                    math.max(
                        mejorValor,
                        numero
                    )
            end
        end
    end

    --==========================================================
    -- VALUES
    --==========================================================

    for _,v in ipairs(obj:GetDescendants()) do

        if v:IsA("IntValue")
        or v:IsA("NumberValue") then

            local nombre =
                string.lower(v.Name)

            if nombre:find("value",1,true)
            or nombre:find("price",1,true)
            or nombre:find("luck",1,true)
            or nombre:find("chance",1,true)
            or nombre:find("worth",1,true) then

                mejorValor =
                    math.max(
                        mejorValor,
                        tonumber(v.Value)
                        or -math.huge
                    )
            end
        end
    end

    return mejorValor
end

--==============================================================
-- BUSCAR MEJOR HUEVO
--==============================================================

local function buscarMejorHuevo()

    local character,root =
        getCharacter()

    if not root then
        return nil
    end

    local mejor = nil

    local mejorValor =
        -math.huge

    local mejorDistancia =
        math.huge

    for _,obj in ipairs(
        workspace:GetDescendants()
    ) do

        if obj:IsA("Model")
        or obj:IsA("BasePart") then

            if pareceHuevo(obj) then

                local part = nil

                if obj:IsA("BasePart") then

                    part = obj

                else

                    part =
                        obj.PrimaryPart
                        or obj:FindFirstChildWhichIsA(
                            "BasePart",
                            true
                        )
                end

                if part then

                    local distancia =
                        (
                            root.Position
                            - part.Position
                        ).Magnitude

                    if distancia <= SEARCH_RADIUS then

                        local valor =
                            obtenerValor(obj)

                        if valor > mejorValor then

                            mejor = obj
                            mejorValor = valor
                            mejorDistancia = distancia

                        elseif valor == mejorValor
                        and distancia < mejorDistancia then

                            mejor = obj
                            mejorDistancia = distancia
                        end
                    end
                end
            end
        end
    end

    return mejor
end

--==============================================================
-- OBTENER PARTE DEL HUEVO
--==============================================================

local function obtenerParte(obj)

    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then

        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    return nil
end


--==============================================================
-- BUSCAR MI PLOT POR OWNER • ROBUSTO
--==============================================================

local function ownerCoincide(valor)

    if valor == nil then
        return false
    end

    -- ObjectValue / referencia directa al jugador
    if typeof(valor) == "Instance" then
        return valor == player
    end

    local texto = tostring(valor)

    return texto == player.Name
        or texto == player.DisplayName
        or texto == tostring(player.UserId)
end


local function objetoTieneMiOwner(obj)

    -- Atributos Owner / Player / UserId
    for _,atributo in ipairs({
        "Owner",
        "OwnerName",
        "Player",
        "PlayerName",
        "Username",
        "UserName",
        "UserId",
        "OwnerUserId",
    }) do

        local valor = obj:GetAttribute(atributo)

        if ownerCoincide(valor) then
            return true
        end
    end

    -- Values
    for _,v in ipairs(obj:GetChildren()) do

        if v:IsA("ObjectValue") then

            if v.Value == player then
                return true
            end

        elseif v:IsA("StringValue") then

            if ownerCoincide(v.Value) then
                return true
            end

        elseif v:IsA("IntValue")
        or v:IsA("NumberValue") then

            if ownerCoincide(v.Value) then
                return true
            end
        end
    end

    return false
end


local function buscarMiPlot()

    local posiblesContenedores = {
        workspace:FindFirstChild("Plots"),
        workspace:FindFirstChild("plots"),
        workspace:FindFirstChild("Bases"),
        workspace:FindFirstChild("bases"),
        workspace:FindFirstChild("BasesFolder"),
        workspace:FindFirstChild("PlotFolder"),
    }

    --==========================================================
    -- 1. BUSCAR DIRECTAMENTE ENTRE LOS PLOTS
    --==========================================================

    for _,contenedor in ipairs(posiblesContenedores) do

        if contenedor then

            for _,plot in ipairs(contenedor:GetChildren()) do

                if objetoTieneMiOwner(plot) then
                    return plot
                end

                for _,obj in ipairs(plot:GetDescendants()) do

                    if objetoTieneMiOwner(obj) then
                        return plot
                    end

                    if obj:IsA("Model")
                    and (obj.Name == player.Name
                    or obj.Name == player.DisplayName) then
                        return plot
                    end
                end
            end
        end
    end

    --==========================================================
    -- 2. BUSCAR OWNER EN TODO WORKSPACE
    --==========================================================

    for _,obj in ipairs(workspace:GetDescendants()) do

        if objetoTieneMiOwner(obj) then

            -- Subir hasta encontrar un Model o Folder que parezca plot/base
            local actual = obj
            local mejorCandidato = nil

            for _ = 1,8 do

                if not actual then
                    break
                end

                if actual:IsA("Model") or actual:IsA("Folder") then
                    mejorCandidato = actual
                end

                local nombre = string.lower(actual.Name)

                if nombre:find("plot",1,true)
                or nombre:find("base",1,true)
                or nombre:find("island",1,true)
                or nombre:find("house",1,true)
                or nombre:find("home",1,true) then
                    mejorCandidato = actual
                    break
                end

                actual = actual.Parent
            end

            if mejorCandidato then
                return mejorCandidato
            end
        end
    end

    return nil
end


--==============================================================
-- BUSCAR SPAWN DE MI PLOT • OWNER + SPAWN
--==============================================================

local function encontrarSpawn(plot)

    if not plot then
        return nil
    end

    local nombresSpawn = {
        "Spawn",
        "PlotSpawn",
        "SpawnLocation",
        "Respawn",
        "PlayerSpawn",
        "HomeSpawn",
        "BaseSpawn",
        "SpawnPoint",
        "SpawnPart",
        "SpawnLocationPart",
    }

    --==========================================================
    -- 1. NOMBRES EXACTOS
    --==========================================================

    for _,nombre in ipairs(nombresSpawn) do

        local obj = plot:FindFirstChild(nombre, true)

        if obj and obj:IsA("BasePart") then
            return obj
        end
    end

    --==========================================================
    -- 2. SPAWNLOCATION
    --==========================================================

    for _,obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("SpawnLocation") then
            return obj
        end
    end

    --==========================================================
    -- 3. CUALQUIER PARTE CON SPAWN/RESPAWN
    --==========================================================

    for _,obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("BasePart") then

            local nombre = string.lower(obj.Name)

            if nombre:find("spawn",1,true)
            or nombre:find("respawn",1,true) then

                return obj
            end
        end
    end

    --==========================================================
    -- 4. BUSCAR PARTES DE HOME/BASE/TELEPORT
    --    SOLO COMO RESPALDO DENTRO DEL PLOT DEL OWNER
    --==========================================================

    for _,obj in ipairs(plot:GetDescendants()) do

        if obj:IsA("BasePart") then

            local nombre = string.lower(obj.Name)

            if nombre:find("home",1,true)
            or nombre:find("base",1,true)
            or nombre:find("teleport",1,true)
            or nombre:find("tp",1,true) then

                return obj
            end
        end
    end

    return nil
end


--==============================================================
-- BUSCAR PROMPT
--==============================================================

local function encontrarPrompt(obj)

    if not obj then
        return nil
    end

    for _,v in ipairs(
        obj:GetDescendants()
    ) do

        if v:IsA("ProximityPrompt") then
            return v
        end
    end

    return nil
end

--==============================================================
-- AGARRAR HUEVO
--==============================================================

local function agarrarHuevo(huevo)

    local prompt =
        encontrarPrompt(huevo)

    if not prompt then

        warn(
            "No encontré ProximityPrompt en:",
            huevo:GetFullName()
        )

        return false
    end

    print(
        "PROMPT:",
        prompt:GetFullName()
    )

    pcall(function()

        prompt.HoldDuration = 0

    end)

    pcall(function()

        fireproximityprompt(prompt)

    end)

    return true
end

--==============================================================
-- AUTO STEAL
--==============================================================

local function ejecutarSteal()

    if BUSY then
        return
    end

    BUSY = true

    --==========================================================
    -- BUSCAR MEJOR HUEVO
    --==========================================================

    status.Text =
        "STATUS: BUSCANDO MEJOR HUEVO"

    local huevo =
        buscarMejorHuevo()

    if not huevo then

        status.Text =
            "STATUS: NO HAY HUEVO"

        BUSY = false

        return
    end

    --==========================================================
    -- OBTENER PARTE
    --==========================================================

    local part =
        obtenerParte(huevo)

    if not part then

        BUSY = false

        return
    end

    --==========================================================
    -- TP AL HUEVO
    --==========================================================

    status.Text =
        "STATUS: TP AL MEJOR HUEVO"

    local character,root =
        getCharacter()

    if not root then

        BUSY = false

        return
    end

    root.CFrame =
        CFrame.new(
            part.Position
            + Vector3.new(
                0,
                HEIGHT_OFFSET,
                0
            )
        )

    task.wait(0.15)

    --==========================================================
    -- CONGELAR
    --==========================================================

    status.Text =
        "STATUS: CONGELADO • AGARRANDO"

    freezeCharacter()

    task.wait(0.1)

    --==========================================================
    -- AGARRAR
    --==========================================================

    agarrarHuevo(huevo)

    task.wait(0.35)

    --==========================================================
    -- BUSCAR MI PLOT
    --==========================================================

    status.Text = "STATUS: BUSCANDO MI PLOT"

    local miPlot = buscarMiPlot()

    if not miPlot then
        warn("No se encontró el plot del jugador")
        unfreezeCharacter()
        status.Text = "STATUS: NO SE ENCONTRÓ MI PLOT"
        task.wait(0.5)
        BUSY = false
        return
    end

    --==========================================================
    -- BUSCAR SPAWN DEL PLOT
    --==========================================================

    status.Text = "STATUS: BUSCANDO SPAWN"

    local spawnPlot = encontrarSpawn(miPlot)

    if not spawnPlot then
        warn("No se encontró Spawn dentro de:", miPlot:GetFullName())
        unfreezeCharacter()
        status.Text = "STATUS: NO SE ENCONTRÓ SPAWN"
        task.wait(0.5)
        BUSY = false
        return
    end

    --==========================================================
    -- TP AL SPAWN DE MI PLOT
    --==========================================================

    status.Text = "STATUS: TP A MI PLOT"

    local character2, root2 = getCharacter()

    if root2 then
        root2.CFrame = CFrame.new(
            spawnPlot.Position + Vector3.new(0, HEIGHT_OFFSET, 0)
        )
        task.wait(0.25)
    end

    --==========================================================
    -- DESCONGELAR
    --==========================================================

    unfreezeCharacter()

    --==========================================================
    -- FIN DEL CICLO
    --==========================================================

    status.Text = "STATUS: ✓ HUEVO LLEVADO AL PLOT"

    task.wait(0.5)
    BUSY = false
end

--==============================================================
-- AUTO LOOP
--==============================================================

task.spawn(function()

    while gui.Parent do

        if AUTO_STEAL
        and not BUSY then

            ejecutarSteal()
        end

        task.wait(0.5)
    end
end)

