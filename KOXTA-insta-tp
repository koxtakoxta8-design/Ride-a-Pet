--==============================================================
-- MEJOR HUEVO DESDE CACHE
--==============================================================

local function GetDetectedTypeCount()
    local Count = 0
    for _ in pairs(EggByType) do
        Count += 1
    end
    return Count
end

local function FindBestEggFast()
    local Best = nil
    local Highest = -math.huge

    for EggType, Data in pairs(EggByType) do
        local Object = Data.Object

        if not Object or not Object.Parent then
            EggByType[EggType] = nil
            EggCache[Object] = nil
        else
            local Priority = EggPriority[EggType] or 0
            if Priority > Highest then
                Highest = Priority
                Best = Data
            end
        end
    end

    return Best
end

